{
  "manifest_version": 3,
  "name": "Send to Recipe Checklist",
  "short_name": "Recipe Checklist",
  "version": "1.0.0",
  "description": "One click on any recipe page opens it in Recipe Checklist: ingredients and a step-by-step checklist.",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Send to Recipe Checklist (Alt+Shift+R)",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" }, "description": "Send this recipe to Recipe Checklist" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "homepage_url": "https://brotherpolo.github.io/recipes/"
}
